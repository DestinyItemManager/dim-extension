{
  "manifest_version": 3,
  "name": "Destiny Item Manager Shortcut",
  "version": "11.0.0",
  "description": "A link to the DIM web app, which provides a robust interface to manage items in Destiny.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "short_name": "DIM",
  "background": {
    "service_worker": "main.js"
  },
  "action": {
    "title": "Launch DIM",
    "default_icon": {
      "19": "icon19.png",
      "38": "icon38.png"
    }
  }
}
